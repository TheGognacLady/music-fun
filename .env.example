# Copy to .env.local; fill values from your authorized backend configuration.
# All VITE_* values referenced by the app are public in the browser bundle.
VITE_BASE_URL=
VITE_API_KEY=
VITE_SOCKET_URL=
VITE_DOMAIN_ADDRESS=http://127.0.0.1:3000
# Optional: local Playwright only; never needed for production/Vercel.
E2E_USER_ID=
